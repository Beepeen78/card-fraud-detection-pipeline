{
  "name": "Fraud Detection Theme",
  "dataColors": [
    "#00B050",
    "#FFC000",
    "#FF6600",
    "#C00000",
    "#1f77b4",
    "#9467bd",
    "#ff7f0e",
    "#2ca02c",
    "#d62728"
  ],
  "background": "#F2F2F2",
  "foreground": "#252423",
  "tableAccent": "#0078D4",
  "visualStyles": {
    "*": {
      "outspacePane": [
        {
          "backgroundColor": {
            "solid": {
              "color": {
                "expr": "'ThemeColor'"
              }
            }
          }
        }
      ],
      "page": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "card": {
      "card": {
        "outline": "None",
        "outlineColor": {
          "solid": {
            "color": "#E1DFDD"
          }
        },
        "outlineWeight": 1,
        "padding": 12,
        "backgroundColor": {
          "solid": {
            "color": "#FFFFFF"
          }
        }
      }
    },
    "pieChart": {
      "dataColors": [
        {
          "solid": {
            "color": "#00B050"
          }
        },
        {
          "solid": {
            "color": "#FFC000"
          }
        },
        {
          "solid": {
            "color": "#FF6600"
          }
        },
        {
          "solid": {
            "color": "#C00000"
          }
        }
      ]
    }
  }
}
